FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir 'Flask>=3.1,<4' 'gunicorn>=23,<25'
COPY src /app/src
# Container de laboratorio, credenciais montadas somente leitura
CMD ["gunicorn","-b","0.0.0.0:8090","--workers","1","--access-logfile","-","src.supervision.panel:create_app()"]
