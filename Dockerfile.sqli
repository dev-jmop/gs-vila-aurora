FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir 'Flask>=3.1,<4' 'gunicorn>=23,<25'
COPY src /app/src
RUN useradd -r -u 10002 -d /nonexistent lab && mkdir /data && chown lab /data
USER 10002
CMD ["gunicorn","-b","0.0.0.0:8091","--workers","1","--access-logfile","-","src.supervision.sqli_lab:create_app()"]
